# Copy to .env and fill in secrets. Never commit .env.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local infra (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://watad:watad@localhost:5432/watad
REDIS_URL=redis://localhost:6379/0

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
